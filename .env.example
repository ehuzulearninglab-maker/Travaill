NEXT_PUBLIC_APP_NAME=Cantine Intelligente
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optionnel pour les anciens modules d'authentification et de fiches conserves dans le projet.
IMPORT_SECRET_KEY=CLE_SECURISEE
AUTH_SECRET=changez-cette-valeur-en-production
DATABASE_URL=postgresql://postgres:mot-de-passe@host:5432/postgres?sslmode=require
# L'application accepte aussi POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING,
# SUPABASE_DB_URL ou SUPABASE_POSTGRES_URL si Vercel/Supabase les fournit.

# Optionnel: l'IA sert uniquement a formuler des explications, jamais a inventer prix ou quantites.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Transcription audio en ligne via OpenAI.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Optionnel: seulement pour la transcription serveur locale ou l'application Windows.
FFMPEG_PATH=
